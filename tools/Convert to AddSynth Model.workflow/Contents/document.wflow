				<dict>
					<key>COMMAND_STRING</key>
					<string>REPO="/Users/roland/Code/synth-ideas"
LOG="$HOME/Library/Logs/addsynth-quickaction.log"
cd "$REPO" || exit 1
{
  echo "=== $(date) — $# file(s)"
  total=0
  for f in "$@"; do
    out=$("$REPO/.venv/bin/python" -m additive.cli import-file "$f" -o "$REPO/models" 2&gt;&amp;1)
    echo "$out"
    n=$(printf '%s' "$out" | tail -1 | grep -o '^[0-9]*')
    total=$((total + ${n:-0}))
  done
  echo "total: $total model(s)"
} &gt;&gt;"$LOG" 2&gt;&amp;1
total=$(tail -1 "$LOG" | grep -o '[0-9]*' | head -1)
osascript -e "display notification \"$total model(s) written to synth-ideas/models\" with title \"AddSynth\" sound name \"Glass\""</string>
					<key>CheckedForUserDefaultShell</key>
